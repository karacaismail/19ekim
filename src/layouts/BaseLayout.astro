---
import '@fontsource-variable/outfit/wght.css';
import '@mantine/core/styles/baseline.layer.css';
import '@mantine/core/styles/default-css-variables.layer.css';
import '@mantine/core/styles/global.layer.css';
import '@mantine/core/styles/Text.layer.css';
import '@mantine/core/styles/Anchor.layer.css';
import '@mantine/core/styles/Title.layer.css';
import '@mantine/core/styles/Table.layer.css';
import '@mantine/core/styles/Timeline.layer.css';
import '@mantine/core/styles/UnstyledButton.layer.css';
import '@mantine/core/styles/Input.layer.css';
import '@mantine/core/styles/NumberInput.layer.css';
import '@mantine/core/styles/Popover.layer.css';
import '@mantine/core/styles/InlineInput.layer.css';
import '@mantine/core/styles/Checkbox.layer.css';
import '@mantine/dates/styles.layer.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { meta } from '../data/program';

interface Props {
  title?: string;
  description?: string;
  /** Sayfaya özgü token kapsamı (ör. giderler: Roboto ve 15 CSS px en küçük metin; tokens.css). */
  page?: string;
}

const { title, description = meta.description, page } = Astro.props;
const pageTitle = title ? `${title} · ${meta.siteTitle}` : meta.siteTitle;
---

<!doctype html>
<html lang="tr" data-mantine-color-scheme="light" data-focus-mode="pointer" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <!-- Renk şeması: kayıtlı tercih (tema düğmesi) yoksa işletim sistemi tercihini izler. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.setAttribute('data-js', '');
        var KEY = 'istoc-plan-tema';
        var query = window.matchMedia('(prefers-color-scheme: dark)');
        function stored() {
          try {
            var value = localStorage.getItem(KEY);
            return value === 'light' || value === 'dark' ? value : null;
          } catch (error) {
            return null;
          }
        }
        function apply() {
          root.setAttribute('data-mantine-color-scheme', stored() || (query.matches ? 'dark' : 'light'));
        }
        apply();
        query.addEventListener('change', apply);
      })();
    </script>
    <!--
      Merkezi klavye odak modu: işaretçi modunda başlar; yalnız Tab ve Shift+Tab açar.
      pointerdown ve touchstart yalnız görsel modu kapatır; odağa ve klavye erişimine dokunmaz.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.setAttribute('data-focus-mode', 'pointer');
        document.addEventListener(
          'keydown',
          function (event) {
            if (event.key === 'Tab') root.setAttribute('data-focus-mode', 'keyboard');
          },
          true
        );
        function pointerMode() {
          root.setAttribute('data-focus-mode', 'pointer');
        }
        document.addEventListener('pointerdown', pointerMode, true);
        document.addEventListener('touchstart', pointerMode, { capture: true, passive: true });
      })();
    </script>
  </head>
  <body>
    <slot />
    <!-- Dar ekranda yatay gezinme şeritlerinde etkin bağlantıyı görünür alana getirir (animasyonsuz). -->
    <script is:inline>
      (function () {
        document.querySelectorAll('.mainnav-list').forEach(function (list) {
          var active = list.querySelector('[aria-current="page"], [data-section="true"]');
          if (!active || list.scrollWidth <= list.clientWidth) return;
          var listBox = list.getBoundingClientRect();
          var box = active.getBoundingClientRect();
          if (box.left < listBox.left || box.right > listBox.right) {
            list.scrollLeft += box.left - listBox.left - (listBox.width - box.width) / 2;
          }
        });
      })();
    </script>
  </body>
</html>
