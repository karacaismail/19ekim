---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RolePage } from '../../views/RolePage';
import { BASE_ROLES } from '../../data/roles';

export function getStaticPaths() {
  return BASE_ROLES.map((role) => ({ params: { slug: role.slug }, props: { title: role.title } }));
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <RolePage client:load pathname={Astro.url.pathname} slug={Astro.params.slug as string} />
</BaseLayout>
